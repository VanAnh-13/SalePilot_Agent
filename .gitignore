# Secrets & env — ignore every .env* variant, keep the committed template.
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*$py.class
.Python
**/.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node / Next
node_modules/
.next/
out/
dist/
.turbo/
*.tsbuildinfo
.pnpm-store/

# App data (runtime)
backend/data/*.db
backend/data/*.db-*
backend/data/chroma/
backend/data/trajectories/
*.log

# Large local data sources (regenerated via backend/scripts import/ETL — kept out of git)
backend/data/catalog_snapshot.json
backend/data/research/catalog_workbook_snapshot.json
backend/data/research/catalog_dmx_snapshot.json
products_detail.xlsx
products_detail.json
